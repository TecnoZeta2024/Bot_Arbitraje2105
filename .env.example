# =============================================================================
# ADVANCED PERSONAL TRADING PLATFORM - CONFIGURATION
# Bot_Arbitraje2105 v2.0 - Production-Ready Trading System
# =============================================================================

# =================
# 🚀 GENERAL SETTINGS
# =================
# Application name and version
APP_NAME=Bot_Arbitraje2105
APP_VERSION=2.0.0
ENVIRONMENT=development  # development, staging, production

# =================
# 💰 CAPITAL & PORTFOLIO
# =================
# Initial trading capital (USD)
INITIAL_CAPITAL=10000.00

# Maximum concurrent positions
MAX_POSITIONS=5

# Maximum portfolio allocation per symbol (percentage)
MAX_SYMBOL_ALLOCATION=20.0

# =================
# 📈 TRADING SYMBOLS
# =================
# Comma-separated list of symbols to trade (SPOT pairs on Binance)
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,ADAUSDT,DOTUSDT,LINKUSDT,BNBUSDT,XRPUSDT,LTCUSDT,SOLUSDT,AVAXUSDT

# Preferred base currencies
BASE_CURRENCIES=USDT,BUSD,USD

# =================
# 🎯 STRATEGY CONFIGURATION
# =================
# Available strategies: scalping, day_trading, triangular_arbitrage, swing_trading
ENABLED_STRATEGIES=scalping,day_trading

# Strategy allocation weights (must sum to 1.0)
STRATEGY_WEIGHTS=0.6,0.4

# Strategy-specific settings
SCALPING_TIMEFRAME=1m
DAY_TRADING_TIMEFRAME=5m,15m,1h
ARBITRAGE_MIN_PROFIT_PCT=0.1

# =================
# 🤖 AI & MACHINE LEARNING
# =================
# Enable AI-powered analysis
AI_ENABLED=true

# Google Gemini API Key - Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI analysis confidence threshold (0.0 to 1.0)
AI_CONFIDENCE_THRESHOLD=0.70

# AI model selection
AI_MODEL=gemini-pro
AI_TEMPERATURE=0.3

# Sentiment analysis settings
SENTIMENT_ANALYSIS_ENABLED=true
NEWS_SENTIMENT_WEIGHT=0.15

# =================
# 🛡️  RISK MANAGEMENT
# =================
# Maximum daily loss (percentage of capital)
MAX_DAILY_LOSS_PCT=2.0

# Maximum position size (percentage of capital)
MAX_POSITION_SIZE_PCT=10.0

# Stop loss percentage (per trade)
STOP_LOSS_PCT=1.0

# Take profit percentage (per trade)
TAKE_PROFIT_PCT=2.0

# Maximum drawdown before pausing (percentage)
MAX_DRAWDOWN_PCT=10.0

# Risk-free rate for Sharpe ratio calculation
RISK_FREE_RATE=0.02

# Position sizing method: fixed, kelly, optimal_f, volatility_adjusted
POSITION_SIZING_METHOD=volatility_adjusted

# =================
# 📊 EXCHANGE CONFIGURATION
# =================
# Primary exchange
EXCHANGE_NAME=binance

# WebSocket configuration
WEBSOCKET_RECONNECT_DELAY=5
WEBSOCKET_MAX_RECONNECT_ATTEMPTS=10
WEBSOCKET_PING_INTERVAL=20

# API rate limiting
API_RATE_LIMIT_PER_MINUTE=1200
API_RATE_LIMIT_BURST=100

# =================
# 🔑 EXCHANGE API KEYS
# =================
# Binance API (for live trading - leave empty for paper trading)
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true

# Coinbase Pro API (optional)
COINBASE_API_KEY=
COINBASE_SECRET_KEY=
COINBASE_PASSPHRASE=
COINBASE_SANDBOX=true

# Kraken API (optional)
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

# =================
# 📱 NOTIFICATIONS & ALERTS
# =================
# Enable notifications
ENABLE_NOTIFICATIONS=true

# Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email notifications
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=notifications@yourdomain.com

# Notification levels: INFO, WARNING, ERROR, CRITICAL
NOTIFICATION_LEVEL=WARNING

# =================
# 📈 SCALPING STRATEGY
# =================
# Profit targets (percentage)
SCALPING_MIN_PROFIT_PCT=0.01
SCALPING_MAX_PROFIT_PCT=0.1

# Stop loss (percentage)
SCALPING_STOP_LOSS_PCT=0.05

# Maximum holding time (minutes)
SCALPING_MAX_HOLD_TIME=30

# Minimum volume requirements
SCALPING_MIN_VOLUME_24H=1000000

# Technical indicators
SCALPING_RSI_PERIOD=7
SCALPING_RSI_OVERSOLD=30
SCALPING_RSI_OVERBOUGHT=70

# =================
# 📊 DAY TRADING STRATEGY
# =================
# Profit targets by risk level
DAY_TRADING_CONSERVATIVE_PROFIT_PCT=0.5
DAY_TRADING_MODERATE_PROFIT_PCT=1.5
DAY_TRADING_AGGRESSIVE_PROFIT_PCT=3.0

# Stop loss (percentage)
DAY_TRADING_STOP_LOSS_PCT=1.0

# Maximum holding time (hours)
DAY_TRADING_MAX_HOLD_TIME=8

# Trend confirmation requirements
DAY_TRADING_MIN_TREND_STRENGTH=0.6

# Multi-timeframe analysis
DAY_TRADING_TIMEFRAMES=5m,15m,1h
DAY_TRADING_CONSENSUS_THRESHOLD=0.7

# =================
# 🔄 ARBITRAGE STRATEGY
# =================
# Minimum profit for arbitrage (percentage)
ARBITRAGE_MIN_PROFIT_PCT=0.1

# Maximum execution time (seconds)
ARBITRAGE_MAX_EXECUTION_TIME=30

# Transaction fee consideration
ARBITRAGE_FEE_THRESHOLD=0.05

# =================
# 🏗️  SYSTEM MONITORING
# =================
# Health check intervals (seconds)
MONITORING_INTERVAL=60
HEALTH_CHECK_INTERVAL=30

# Performance monitoring
PERFORMANCE_REPORT_INTERVAL=3600  # 1 hour
DAILY_REPORT_TIME=23:59

# System resource thresholds
MAX_CPU_USAGE=80
MAX_MEMORY_USAGE=80
MAX_DISK_USAGE=90

# =================
# 📊 DATA & ANALYTICS
# =================
# Database configuration
DATABASE_URL=sqlite:///data/trading_data.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Data retention (days)
MARKET_DATA_RETENTION=30
TRADE_DATA_RETENTION=365
LOG_DATA_RETENTION=90

# =================
# 🔍 TECHNICAL ANALYSIS
# =================
# Moving averages
SMA_PERIODS=10,20,50,200
EMA_PERIODS=12,26

# Oscillators
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# MACD settings
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Bollinger Bands
BOLLINGER_PERIOD=20
BOLLINGER_STD=2

# Volume analysis
VOLUME_SMA_PERIOD=20
VOLUME_SPIKE_THRESHOLD=2.0

# =================
# 🚀 PERFORMANCE OPTIMIZATION
# =================
# Data processing
DATA_BUFFER_SIZE=1000
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT=30

# Memory management
CACHE_SIZE_MB=512
CACHE_TTL_SECONDS=300

# CPU optimization
MAX_WORKER_THREADS=4
ASYNC_CONCURRENCY_LIMIT=100

# =================
# 🔐 SECURITY
# =================
# API security
API_KEY_ROTATION_DAYS=90
ENCRYPT_SENSITIVE_DATA=true

# Session management
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5

# =================
# 🐛 DEVELOPMENT & DEBUGGING
# =================
# Trading mode
PAPER_TRADING=true  # Set to false for live trading
BACKTEST_MODE=false

# Logging configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_FILE=true
LOG_FILE_PATH=logs/trading_{date}.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# Debug features
DEBUG_MODE=false
PROFILE_PERFORMANCE=false
MOCK_AI_RESPONSES=false

# =================
# 🌐 WEB DASHBOARD (Optional)
# =================
# Enable web interface
WEB_INTERFACE_ENABLED=false
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24

# =================
# ☁️  CLOUD & DEPLOYMENT
# =================
# Redis configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Message queue (for distributed processing)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =================
# 📋 COMPLIANCE & REGULATION
# =================
# Regulatory compliance
ENABLE_TRADE_REPORTING=true
COMPLIANCE_JURISDICTION=US

# Audit trail
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=logs/audit_{date}.log

# =================
# 🔧 MAINTENANCE
# =================
# Automatic restarts
AUTO_RESTART_ON_ERROR=true
MAX_RESTART_ATTEMPTS=3
RESTART_DELAY_SECONDS=60

# System maintenance windows
MAINTENANCE_WINDOW_START=02:00
MAINTENANCE_WINDOW_END=04:00
MAINTENANCE_TIMEZONE=UTC

# =================
# 📊 ADVANCED ANALYTICS
# =================
# Machine learning model updates
ML_MODEL_UPDATE_FREQUENCY=daily
ML_TRAINING_DATA_DAYS=30

# Portfolio optimization
PORTFOLIO_REBALANCE_FREQUENCY=weekly
RISK_PARITY_ENABLED=false

# Market regime detection
MARKET_REGIME_DETECTION=true
REGIME_CHANGE_THRESHOLD=0.3

# =============================================================================
# IMPORTANT NOTES:
# 
# 1. 🔐 SECURITY: Never commit real API keys to version control
# 2. 📝 TESTING: Start with PAPER_TRADING=true for testing
# 3. 💰 CAPITAL: Start with small amounts until you validate performance
# 4. 📊 MONITORING: Enable all monitoring features for production
# 5. 🔄 BACKUPS: Regularly backup your configuration and data
# 6. 📈 OPTIMIZATION: Monitor performance and adjust parameters gradually
# 
# For detailed documentation, visit: https://github.com/your-repo/docs
# =============================================================================
