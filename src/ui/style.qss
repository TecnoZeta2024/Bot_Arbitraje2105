    border-radius: 9px;
}

QSlider::groove:vertical {
    border: 1px solid #505050;
    width: 8px;
    background: #3a3a3a;
    margin: 0 2px;
    border-radius: 4px;
}

QSlider::handle:vertical {
    background: #0078d7;
    border: 1px solid #0078d7;
    height: 18px;
    margin: 0 -5px;
    border-radius: 9px;
}

