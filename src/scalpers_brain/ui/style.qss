/* Tema oscuro profesional para Scalper's Brain */

/* Paleta de colores principal */
/* 
 * Fondo: #1E1E1E (Gris oscuro)
 * Fondo secundario: #2D2D30 (Gris oscuro medio)
 * Acentuación: #007ACC (Azul)
 * Texto: #FFFFFF (Blanco)
 * Texto secundario: #BBBBBB (Gris claro)
 * 
 * Colores semánticos:
 * - Compra/Éxito: #77DD77 (Verde)
 * - Venta/Error: #FF6B6B (Rojo)
 * - Advertencia: #FFD700 (Amarillo)
 * - Info: #29B6F6 (Azul claro)
 */

/* Estilos globales */
QWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 12px;
}

/* Barra de título */
QMainWindow::title {
    background-color: #2D2D30;
    color: white;
    font-weight: bold;
}

/* Menús */
QMenuBar {
    background-color: #2D2D30;
    color: #FFFFFF;
    border-bottom: 1px solid #3E3E42;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #007ACC;
    color: #FFFFFF;
}

QMenu {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
}

QMenu::item {
    padding: 6px 30px 6px 20px;
}

QMenu::item:selected {
    background-color: #007ACC;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #3E3E42;
    margin: 4px 0px;
}

/* Barra de herramientas */
QToolBar {
    background-color: #2D2D30;
    border-bottom: 1px solid #3E3E42;
    spacing: 3px;
    padding: 3px;
}

QToolBar::handle {
    background-color: #3E3E42;
    width: 1px;
    height: 20px;
    margin: 0px 4px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #3E3E42;
    border: 1px solid #3E3E42;
}

QToolButton:pressed {
    background-color: #007ACC;
    border: 1px solid #007ACC;
}

/* Barra de estado */
QStatusBar {
    background-color: #2D2D30;
    color: #BBBBBB;
    border-top: 1px solid #3E3E42;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    background-color: transparent;
    padding: 2px 6px;
}

/* Paneles acoplables */
QDockWidget {
    background-color: #1E1E1E;
    border: 1px solid #3E3E42;
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(undock.png);
}

QDockWidget::title {
    background-color: #2D2D30;
    padding-left: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-bottom: 1px solid #3E3E42;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #3E3E42;
    border-radius: 2px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #3E3E42;
}

QTabBar::tab {
    background-color: #2D2D30;
    color: #BBBBBB;
    padding: 8px 16px;
    border: 1px solid transparent;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-bottom: 1px solid #1E1E1E;
}

QTabBar::tab:hover:!selected {
    background-color: #3E3E42;
    color: #FFFFFF;
}

/* Tablas */
QTableView {
    background-color: #1E1E1E;
    alternate-background-color: #2D2D30;
    border: 1px solid #3E3E42;
    gridline-color: #3E3E42;
    selection-background-color: #007ACC;
    selection-color: #FFFFFF;
}

QTableView::item {
    padding: 4px;
}

QHeaderView {
    background-color: #2D2D30;
    border-bottom: 1px solid #3E3E42;
}

QHeaderView::section {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: none;
    padding: 6px;
    font-weight: bold;
}

QHeaderView::section:checked {
    background-color: #007ACC;
}

QHeaderView::section:hover {
    background-color: #3E3E42;
}

/* Botones */
QPushButton {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 2px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #3E3E42;
}

QPushButton:pressed {
    background-color: #007ACC;
    border-color: #007ACC;
}

QPushButton:disabled {
    background-color: #2D2D30;
    color: #777777;
    border-color: #3E3E42;
}

/* Cajas de texto */
QLineEdit, QTextEdit {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 2px;
    padding: 4px;
    selection-background-color: #007ACC;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #007ACC;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #2D2D30;
    color: #777777;
    border-color: #3E3E42;
}

/* Combobox */
QComboBox {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 2px;
    padding: 4px 8px;
    min-width: 100px;
}

QComboBox:hover {
    background-color: #3E3E42;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #3E3E42;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(down_arrow.png);
}

QComboBox QAbstractItemView {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    selection-background-color: #007ACC;
    selection-color: #FFFFFF;
}

/* Checkbox */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    background-color: #1E1E1E;
    border: 1px solid #3E3E42;
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    background-color: #007ACC;
    border: 1px solid #007ACC;
    border-radius: 2px;
}

QCheckBox::indicator:hover {
    border: 1px solid #007ACC;
}

/* Spinbox */
QSpinBox, QDoubleSpinBox {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 2px;
    padding: 4px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-left: 1px solid #3E3E42;
    border-bottom: 1px solid #3E3E42;
    width: 16px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border-left: 1px solid #3E3E42;
    width: 16px;
}

/* Slider */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background-color: #3E3E42;
    margin: 2px 0;
}

QSlider::handle:horizontal {
    background-color: #007ACC;
    border: none;
    width: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider::add-page:horizontal {
    background-color: #3E3E42;
}

QSlider::sub-page:horizontal {
    background-color: #007ACC;
}

/* Scrollbar */
QScrollBar:vertical {
    background-color: #1E1E1E;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #3E3E42;
    min-height: 20px;
    border-radius: 3px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #007ACC;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1E1E1E;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #3E3E42;
    min-width: 20px;
    border-radius: 3px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #007ACC;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Grupos */
QGroupBox {
    border: 1px solid #3E3E42;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
    background-color: #1E1E1E;
    color: #BBBBBB;
}

/* Formularios */
QFormLayout {
    spacing: 8px;
}

/* Tooltips */
QToolTip {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #007ACC;
    padding: 4px;
}

/* Diálogos */
QDialog {
    background-color: #1E1E1E;
    border: 1px solid #3E3E42;
}

/* Listas */
QListWidget {
    background-color: #1E1E1E;
    alternate-background-color: #2D2D30;
    border: 1px solid #3E3E42;
    selection-background-color: #007ACC;
    selection-color: #FFFFFF;
}

QListWidget::item {
    padding: 4px;
}

QListWidget::item:hover {
    background-color: #3E3E42;
}

QListWidget::item:selected {
    background-color: #007ACC;
    color: #FFFFFF;
}

/* Splitter */
QSplitter::handle {
    background-color: #3E3E42;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #007ACC;
}

/* Ajustes específicos para gráficos */
QWidget#ChartWidget {
    background-color: #1E1E1E;
}

/* Barra de progreso */
QProgressBar {
    border: 1px solid #3E3E42;
    border-radius: 2px;
    text-align: center;
    background-color: #1E1E1E;
    color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: #007ACC;
    width: 20px;
}

/* Calendario */
QCalendarWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
}

QCalendarWidget QAbstractItemView {
    background-color: #2D2D30;
    selection-background-color: #007ACC;
    selection-color: #FFFFFF;
}

QCalendarWidget QWidget {
    alternate-background-color: #2D2D30;
}

QCalendarWidget QMenu {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
}

/* Cuadros de diálogo de mensajes */
QMessageBox {
    background-color: #1E1E1E;
}

QMessageBox QLabel {
    color: #FFFFFF;
}

/* Ajustes específicos para estrategias */
QWidget#StrategyWidget {
    background-color: #2D2D30;
    border-radius: 6px;
    padding: 10px;
}
